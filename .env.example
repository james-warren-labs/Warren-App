# Server-side provider selection: auto (Groq first, Gemini fallback), groq, or gemini.
AI_PROVIDER=auto
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional model overrides. Defaults are provided by the server.
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-3.8-flash

# API server settings
PORT=3000
HOST=0.0.0.0
CHAT_RATE_LIMIT=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,http://localhost

# Frontend uses /api by default; keep this same-origin path for local Vite proxy.
VITE_API_BASE_URL=/api